{
  "name": "stage-utility",
  "version": "1.27.0-beta.8",
  "description": "Display band lineup and wireless device status pulled from Planning Center Online and Shure wireless systems.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Cornerstone Production",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cornerstone-Production/Stage-Utility.git"
  },
  "homepage": "https://github.com/Cornerstone-Production/Stage-Utility#readme",
  "bugs": {
    "url": "https://github.com/Cornerstone-Production/Stage-Utility/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "build": "vite build",
    "servicecue:build": "vite build --config vite.servicecue.config.ts",
    "servicecue:dev": "npm run servicecue:build && npm --prefix publish/servicecue run dev",
    "servicecue:deploy": "npm run servicecue:build && npm --prefix publish/servicecue run deploy",
    "server": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "lint": "eslint .",
    "icons": "node scripts/build-icons.mjs",
    "docs:screenshots": "node scripts/docs-screenshots/run.mjs",
    "test": "node scripts/run-tests.mjs",
    "type-check": "tsc --noEmit",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "hls.js": "1.7.3",
    "lucide-react": "^1.58.0",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.73.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@11.11.0"
}
