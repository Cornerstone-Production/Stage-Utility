{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@renderer/*": ["./renderer/*"],
      "@main/*": ["./main/*"]
    }
  },
  "include": [
    "renderer",
    "server.ts",
    "vite.config.ts",
    "vite.servicecue.config.ts",
    "scripts/servicecue-bundle.ts",
    "scripts/servicecue-bundle*.test.ts",
    "main/**/*.test.ts",
    "publish/servicecue/src/**/*.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
