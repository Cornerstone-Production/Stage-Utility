# Dependencies
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, so a
# symlink named node_modules slips straight past it -- which is how one pointing
# at an absolute path on a developer's machine was committed to beta by a
# `git add -A`. Without the slash this matches both.
node_modules

# Build output
build/
.vite/

# The public ServiceCue viewer's build (npm run servicecue:build), which the Worker
# in publish/servicecue/ serves as its static assets, and wrangler's local state
# and secrets for it. A .dev.vars holds the publishing token.
publish/servicecue/public/
publish/servicecue/.wrangler/
publish/servicecue/.dev.vars*

# The Mac output helper's SwiftPM build, the .app it assembles, the CEF download
# cache and the CMake build of the browser host, and cmake/ninja in a venv
helper/macos/.build/
helper/macos/dist/
helper/macos/.cef/
helper/macos/.cef-build/
helper/macos/.tools/

# Env / secrets
.env
.env.local
*.key

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Glaze memory/internal
.mic-display-memory/
.mcp.json

# Claude Code local config
.claude/

# Local SenSource API diagnostic captures (contain org names/addresses/MACs — never commit)
sensource-capture*.json
sensource-probe*.json

# Local tooling scratch (Playwright MCP screenshots/logs, impeccable design plugin)
.playwright-mcp/
.impeccable/

# Internal working documents. These are notes to ourselves — proposals with a
# "decisions for you" section, and references to local tooling paths that exist
# on no other machine.
#
# Specs and plans live in the private stage-utility-plans repo, not here: they
# carry decision notes, mockup links and local paths. Ignored so a plan an agent
# writes to the default location cannot be committed by accident. Protocol
# research that code cites is public, in docs/research/.
docs/superpowers/
docs/design-overhaul/
DESIGN_TOKENS_PROPOSAL.md
scripts/survival/.survival-*.log

# .superpowers/ is an agent's own working ledger — which task it is on, which
# commit each finished at. It records the WORKING, not the decision, and
# nothing in a PR review is better for having it.
.superpowers/

# Screenshots taken while driving the app during development.
#
# The `*.playwright.png` rule was too narrow: a screenshot saved under any other
# name was committable, and one was — a mic-slots display carrying ten real
# faces and names, including children, into this PUBLIC repo, where it rode 38
# release tags. Root-level raster files are always debris here, so ignore them
# by location rather than by filename. Images that belong in the product live
# under public/ or docs/ and are unaffected.
*.playwright.png
.playwright-mcp/
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Probe captures. These are live pulls off a real account -- encoder and
# schedule uuids, service names, the church's own name. One reached beta in
# 52e8d9c before anyone noticed. The fixtures a test needs get typed into the
# test, redacted; the raw capture never gets committed.
resi-capture.json
*-capture.json

# Local list for scripts/check-public-hygiene.mjs (see docs/contributing.md)
.private-terms
